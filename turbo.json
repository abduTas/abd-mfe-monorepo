{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "@abd/shell#build": {
      "dependsOn": ["^build", "@abd/state#build", "@abd/design-system#build"]
    },
    "@abd/host#build": {
      "dependsOn": ["^build", "@abd/state#build", "@abd/design-system#build"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "@abd/shell#dev": {
      "dependsOn": ["@abd/design-system#build"],
      "cache": false,
      "persistent": true
    },
    "@abd/host#dev": {
      "dependsOn": ["@abd/design-system#build"],
      "cache": false,
      "persistent": true
    },
    "storybook": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "test": {
      "dependsOn": ["^test"]
    }
  }
}
