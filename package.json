{
  "name": "abd-mfe-monorepo",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo dev --filter=@abd/design-system --filter=@abd/host",
    "dev:mfe": "turbo dev --filter=@abd/design-system --filter=@abd/state --filter=@abd/shell --filter=@abd/host",
    "storybook": "turbo storybook --filter=@abd/design-system",
    "build": "turbo build",
    "lint": "turbo lint",
    "test": "turbo test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "prettier": "^3.5.3",
    "turbo": "^2.5.4"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "npm@10.9.2"
}
